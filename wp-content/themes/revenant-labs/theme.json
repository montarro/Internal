{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "800px",
			"wideSize": "1280px"
		},
		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"dimensions": {
			"aspectRatio": true,
			"minHeight": true
		},
		"position": {
			"sticky": true
		},
		"color": {
			"custom": true,
			"customDuotone": false,
			"customGradient": true,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"link": true,
			"heading": true,
			"button": true,
			"caption": true,
			"palette": [
				{
					"slug": "white",
					"color": "#FFFFFF",
					"name": "White"
				},
				{
					"slug": "bone",
					"color": "#F4F1E8",
					"name": "Bone"
				},
				{
					"slug": "violet",
					"color": "#6F47E8",
					"name": "Revenant Violet"
				},
				{
					"slug": "violet-dark",
					"color": "#5633C7",
					"name": "Violet Dark"
				},
				{
					"slug": "violet-soft",
					"color": "#F1EDFF",
					"name": "Soft Violet Background"
				},
				{
					"slug": "near-black",
					"color": "#090B0F",
					"name": "Near Black"
				},
				{
					"slug": "dark-panel",
					"color": "#0B0D12",
					"name": "Dark Product Panel"
				},
				{
					"slug": "warm-border",
					"color": "#E0D8C8",
					"name": "Warm Border"
				},
				{
					"slug": "muted-text",
					"color": "#6B6872",
					"name": "Muted Text"
				}
			],
			"gradients": [
				{
					"slug": "violet-glow",
					"gradient": "radial-gradient(60% 60% at 50% 40%, rgba(111, 71, 232, 0.28) 0%, rgba(9, 11, 15, 0) 100%)",
					"name": "Violet Glow"
				},
				{
					"slug": "panel-depth",
					"gradient": "linear-gradient(160deg, #0B0D12 0%, #12101E 100%)",
					"name": "Panel Depth"
				},
				{
					"slug": "bone-fade",
					"gradient": "linear-gradient(180deg, #FFFFFF 0%, #F4F1E8 100%)",
					"name": "Bone Fade"
				}
			]
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"slug": "subtle",
					"shadow": "0 1px 2px rgba(9, 11, 15, 0.04), 0 2px 8px rgba(9, 11, 15, 0.04)",
					"name": "Subtle"
				},
				{
					"slug": "panel",
					"shadow": "0 12px 40px rgba(9, 11, 15, 0.10)",
					"name": "Panel"
				},
				{
					"slug": "violet-glow",
					"shadow": "0 18px 60px rgba(111, 71, 232, 0.18)",
					"name": "Violet Glow"
				}
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{
					"slug": "20",
					"size": "0.5rem",
					"name": "1 · XX Small"
				},
				{
					"slug": "30",
					"size": "1rem",
					"name": "2 · X Small"
				},
				{
					"slug": "40",
					"size": "1.5rem",
					"name": "3 · Small"
				},
				{
					"slug": "50",
					"size": "2.25rem",
					"name": "4 · Medium"
				},
				{
					"slug": "60",
					"size": "clamp(2.5rem, 4vw, 3.5rem)",
					"name": "5 · Large"
				},
				{
					"slug": "70",
					"size": "clamp(3rem, 6vw, 5rem)",
					"name": "6 · X Large"
				},
				{
					"slug": "80",
					"size": "clamp(2.75rem, 7vw, 6.25rem)",
					"name": "7 · Section"
				},
				{
					"slug": "90",
					"size": "clamp(3.5rem, 9vw, 7rem)",
					"name": "8 · Section Large"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": false,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textDecoration": true,
			"textTransform": true,
			"writingMode": false,
			"fontFamilies": [
				{
					"slug": "heading",
					"name": "Inter Tight (Headings)",
					"fontFamily": "\"Inter Tight\", \"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "body",
					"name": "Inter (Body & Interface)",
					"fontFamily": "\"Inter\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "IBM Plex Mono (Technical)",
					"fontFamily": "\"IBM Plex Mono\", ui-monospace, SFMono-Regular, \"SF Mono\", Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "x-small",
					"size": "0.75rem",
					"name": "X Small"
				},
				{
					"slug": "small",
					"size": "0.875rem",
					"name": "Small"
				},
				{
					"slug": "medium",
					"size": "1rem",
					"name": "Medium"
				},
				{
					"slug": "large",
					"size": "1.125rem",
					"name": "Large"
				},
				{
					"slug": "x-large",
					"size": "clamp(1.25rem, 1.15rem + 0.5vw, 1.5rem)",
					"name": "X Large"
				},
				{
					"slug": "xx-large",
					"size": "clamp(1.625rem, 1.35rem + 1.4vw, 2.375rem)",
					"name": "XX Large"
				},
				{
					"slug": "huge",
					"size": "clamp(2.125rem, 1.6rem + 2.6vw, 3.5rem)",
					"name": "Huge"
				},
				{
					"slug": "display",
					"size": "clamp(2.625rem, 1.75rem + 4.2vw, 4.75rem)",
					"name": "Display"
				}
			]
		},
		"custom": {
			"gutter": "clamp(1rem, 4vw, 2.5rem)",
			"layout": {
				"maxWidth": "1440px"
			},
			"radius": {
				"button": "3px",
				"card": "6px",
				"panel": "10px"
			},
			"border": {
				"hairline": "1px solid var(--wp--preset--color--warm-border)",
				"dark": "1px solid rgba(255, 255, 255, 0.12)"
			},
			"transition": {
				"base": "180ms cubic-bezier(0.2, 0, 0.2, 1)"
			}
		},
		"blocks": {
			"core/button": {
				"border": {
					"radius": true
				}
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--near-black)"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "var(--wp--custom--gutter)",
				"right": "var(--wp--custom--gutter)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65",
			"fontWeight": "400",
			"letterSpacing": "-0.005em"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "700",
					"letterSpacing": "-0.04em",
					"lineHeight": "1.05"
				},
				"color": {
					"text": "var(--wp--preset--color--near-black)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"fontWeight": "800",
					"lineHeight": "0.98"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--huge)",
					"fontWeight": "800",
					"lineHeight": "1"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.1"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"lineHeight": "1.2",
					"letterSpacing": "-0.02em"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)",
					"lineHeight": "1.3",
					"letterSpacing": "-0.01em"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"fontWeight": "500",
					"letterSpacing": "0.12em",
					"textTransform": "uppercase",
					"lineHeight": "1.4"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--violet)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--violet-dark)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--violet-dark)"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--violet)",
					"text": "var(--wp--preset--color--white)"
				},
				"border": {
					"radius": "var(--wp--custom--radius--button)",
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--violet)"
				},
				"spacing": {
					"padding": {
						"top": "0.9rem",
						"bottom": "0.9rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--body)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "600",
					"letterSpacing": "0.04em",
					"lineHeight": "1.1",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--violet-dark)",
						"text": "var(--wp--preset--color--white)"
					},
					"border": {
						"color": "var(--wp--preset--color--violet-dark)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--violet-dark)",
						"text": "var(--wp--preset--color--white)"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--preset--color--violet-dark)",
						"text": "var(--wp--preset--color--white)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted-text)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-small)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "800",
					"letterSpacing": "0.02em",
					"textTransform": "uppercase"
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)"
				}
			},
			"core/pullquote": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--xx-large)"
				}
			},
			"core/quote": {
				"border": {
					"left": {
						"color": "var(--wp--preset--color--violet)",
						"style": "solid",
						"width": "2px"
					}
				},
				"spacing": {
					"padding": {
						"left": "var(--wp--preset--spacing--40)"
					}
				}
			},
			"core/code": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"color": {
					"background": "var(--wp--preset--color--bone)"
				},
				"border": {
					"color": "var(--wp--preset--color--warm-border)",
					"radius": "var(--wp--custom--radius--card)",
					"style": "solid",
					"width": "1px"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--warm-border)"
				}
			},
			"core/table": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)"
				}
			},
			"core/details": {
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--40)",
						"bottom": "var(--wp--preset--spacing--40)"
					}
				},
				"border": {
					"bottom": {
						"color": "var(--wp--preset--color--warm-border)",
						"style": "solid",
						"width": "1px"
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--near-black)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--violet)"
							}
						},
						":focus": {
							"color": {
								"text": "var(--wp--preset--color--violet)"
							}
						}
					}
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"letterSpacing": "0.1em",
					"textTransform": "uppercase"
				}
			},
			"core/post-date": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--x-small)",
					"letterSpacing": "0.08em"
				},
				"color": {
					"text": "var(--wp--preset--color--muted-text)"
				}
			},
			"woocommerce/product-price": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--large)",
					"fontWeight": "700",
					"letterSpacing": "-0.02em"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "announcement-bar",
			"title": "Announcement Bar",
			"area": "header"
		},
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "checkout-header",
			"title": "Checkout Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		},
		{
			"name": "mini-cart",
			"title": "Mini-Cart",
			"area": "uncategorized"
		},
		{
			"name": "research-notice",
			"title": "Research-Use Notice (first visit)",
			"area": "uncategorized"
		}
	],
	"customTemplates": [
		{
			"name": "page-contact",
			"title": "Page · Contact",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-research",
			"title": "Page · Research",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-faqs",
			"title": "Page · FAQs",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-lab-reports",
			"title": "Page · Lab Reports / COA Library",
			"postTypes": [ "page" ]
		},
		{
			"name": "page-wide",
			"title": "Page · Wide (no title)",
			"postTypes": [ "page" ]
		}
	]
}
